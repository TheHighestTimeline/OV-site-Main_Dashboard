# OVMG Dashboard — environment template.
#
# PLACEHOLDERS ONLY. Never commit real values. Tanner provisions the live values
# in the Netlify UI (Site settings → Environment variables). `.env` and
# `.env.local` are gitignored; keep it that way.

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# PEM public key. Enables networkless JWT verification, which avoids the JWKS
# fetch that fails in some runtimes. Single-line values with literal \n are
# normalized by _auth.js.
CLERK_JWT_KEY=
# Comma-separated bootstrap admin emails, so the owner cannot be locked out
# before Clerk roles are assigned.
ADMIN_EMAILS=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Service-role key, NOT the anon key. Never exposed to the browser: the frontend
# only ever talks to Netlify functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Airtable ─────────────────────────────────────────────────────────────────
# AIRTABLE_TOKEN is the name this codebase has always used. AIRTABLE_API_KEY is
# accepted as an alias.
AIRTABLE_TOKEN=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appgZ4EvfGEI4owb7

# Threads tab: the Participations table id (tblXXXXXXXXXXXXXX). Create the table
# first — the field list is in docs/THREADS_TAB.md. Until this is set, the
# Threads tab renders an explanation instead of the board, and Triage and the
# queues still work.
AIRTABLE_TB_PARTICIPATIONS=

# Optional per-table overrides. Defaults are the verified ids in _airtable.js.
# AIRTABLE_TABLE_TASKS=
# AIRTABLE_TABLE_CONTACTS=
# AIRTABLE_TABLE_OPPORTUNITIES=
# AIRTABLE_TABLE_DOCUMENTS=
# AIRTABLE_TABLE_ACTIVITIES=
# AIRTABLE_TABLE_PROJECTS=

# ── Google (Gmail, Calendar, Drive) ──────────────────────────────────────────
# One OAuth app covers all three. drive.metadata.readonly is already in
# REQUESTED_SCOPES and is sufficient for files.list and permissions.list, so the
# Drive detector needs no re-consent.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
PUBLIC_URL=

# ── AI ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Threads / COO layer ──────────────────────────────────────────────────────
# Clerk user id whose connected Google account the scheduled scans run as.
# Scheduled invocations have no signed-in user, so they need one named here.
COO_SCAN_USER_ID=

# Optional. Data rooms are read from the Opportunities "Data Room" field
# automatically, so adding a workstream auto-enrolls it. Use this only for
# folders that are not attached to an opportunity. Comma-separated folder ids
# or Drive URLs.
COO_DATA_ROOM_FOLDER_IDS=

# Entities the `ops` role must never see threads for. Comma-separated, matched
# case-insensitively against the Entity field. Defaults cover the obvious
# capital-raise labels; set it explicitly once the real entity names are fixed.
COO_CAPITAL_ENTITIES=

# Addresses that count as "us" when deciding message direction. GMAIL_SENDER is
# included automatically. Getting this wrong flips every arrow in the timeline.
COO_OUR_ADDRESSES=

# Extra eSignature notification senders beyond the built-in Google / DocuSign /
# Dropbox Sign list. Comma-separated.
COO_ESIGN_SENDERS=

# Tuning. Defaults shown.
# COO_GMAIL_MAX_THREADS=40
# COO_GMAIL_BACKFILL_DAYS=30
# COO_SIGNAL_LOOKBACK_DAYS=7

# ── Misc ─────────────────────────────────────────────────────────────────────
# Extra CORS origins beyond the Netlify URL and the local dev ports.
EXTRA_ALLOWED_ORIGINS=
